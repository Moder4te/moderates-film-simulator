{
  "manifestVersion": 5,
  "id": "com.filmsim.photoshop",
  "name": "Film Simulation",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "filmsim.main",
      "label": {
        "default": "Film Simulation"
      },
      "minimumSize": { "width": 260, "height": 400 },
      "maximumSize": { "width": 800, "height": 2400 },
      "preferredDockedSize": { "width": 320, "height": 720 },
      "preferredFloatingSize": { "width": 360, "height": 760 }
    },
    {
      "type": "panel",
      "id": "filmsim.preview",
      "label": {
        "default": "Film Sim 미리보기"
      },
      "minimumSize": { "width": 180, "height": 160 },
      "maximumSize": { "width": 1600, "height": 1600 },
      "preferredDockedSize": { "width": 320, "height": 320 },
      "preferredFloatingSize": { "width": 360, "height": 360 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "ipc": { "enablePluginCommunication": true }
  }
}
