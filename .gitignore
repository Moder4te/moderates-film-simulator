# UXP devtools 세션 파일 (plugin load 시 생성)
.uxprc

# Claude Code 로컬 설정
.claude/

# 로그·OS 파일
*.log
.DS_Store
Thumbs.db

# 의존성 (현재 없음, 향후 대비)
node_modules/

# 빌드 산출물 (.ccx는 GitHub 릴리스로 배포)
dist/

# 플러그인이 내보낸 산출물. 엔진에서 언제든 다시 굽는 것이라 저장소에 둘 이유가 없고,
# 파일 하나가 200KB대라 커밋하면 이력이 금세 무거워진다.
lut/
*.cube

# tools/ 파이썬 캐시 (TDS 추출기 실행 시 생성)
__pycache__/
*.pyc

# 제조사 TDS PDF — 저작물이라 재배포하지 않는다.
# 여기서 추출한 수치 데이터만 src/films.js에 담는다 (v2plan.md 10장).
tools/tds/
*.pdf

# 패키징 스테이징 (tools/build-ccx.js가 만든다)
build/

# 앱별 lib/ 는 tools/sync-libs.js가 core/·host/·shared/ 에서 복사해 만든다.
# core/ 가 원본이고 여기는 산출물이다 — 직접 고치면 다음 sync에 지워진다.
apps/*/lib/
