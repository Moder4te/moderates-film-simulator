{
  "manifestVersion": 5,
  "id": "com.filmsim.finish",
  "name": "Film Simulation — Finish",
  "version": "2.8.1",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/plugin-icon.png",
      "scale": [
        1
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "light",
        "lightest"
      ],
      "species": [
        "pluginList"
      ]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon@2x.png",
      "scale": [
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "light",
        "lightest"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "filmsim.finish",
      "label": {
        "default": "Film Sim 마감"
      },
      "minimumSize": {
        "width": 260,
        "height": 400
      },
      "maximumSize": {
        "width": 800,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 660
      },
      "icons": [
        {
          "width": 24,
          "height": 24,
          "path": "icons/plugin-icon.png",
          "scale": [
            1
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "light",
            "lightest"
          ]
        },
        {
          "width": 48,
          "height": 48,
          "path": "icons/plugin-icon@2x.png",
          "scale": [
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "light",
            "lightest"
          ]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "ipc": {
      "enablePluginCommunication": true
    }
  }
}
